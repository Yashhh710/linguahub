{
  "name": "linguahub",
  "version": "2.0.0",
  "description": "LinguaHub - full-stack language learning platform (Node.js, Express, MongoDB, Socket.io, Firebase)",
  "main": "src/server.js",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "import:curriculum": "node scripts/import-curriculum.js",
    "import:curriculum:check": "node scripts/import-curriculum.js --dry-run",
    "make-admin": "node scripts/make-admin.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-validator": "^7.2.0",
    "firebase-admin": "^12.7.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.3",
    "socket.io": "^4.8.1"
  },
  "devDependencies": { "nodemon": "^3.1.7" }
}
